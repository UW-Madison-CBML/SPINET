# Step 3a/3b: build the CHARMM22* system and equilibrate it (one job per sequence).
universe                = docker
docker_image            = $(md_image)
executable              = $(pipeline_dir)/condor/equil.sh
arguments               = $(who) $(equil_ns) $(seed)
transfer_input_files    = $(pipeline_dir)/build_system.py, $(pipeline_dir)/run_md.py, fold
transfer_output_files   = equil_$(who)
initialdir              = $(run_dir)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
log                     = logs/equil_$(who).log
output                  = logs/equil_$(who).out
error                   = logs/equil_$(who).err
request_cpus            = 4
request_memory          = 16GB
request_disk            = 20GB
request_gpus            = 1
+WantGPULab             = true
+GPUJobLength           = "short"
if ! defined gpu_requirements
  gpu_requirements      = (Machine == "bhaskargpu4000.chtc.wisc.edu" || TARGET.GPUs_DeviceName == "NVIDIA H200" || TARGET.GPUs_DeviceName == "NVIDIA H200 NVL" || TARGET.GPUs_DeviceName == "NVIDIA H100 80GB HBM3" || TARGET.GPUs_DeviceName == "NVIDIA A100-SXM4-80GB")
endif
Requirements            = (Target.HasCHTCStaging == true) && $(gpu_requirements)
queue
