# Step 4: compare the simulations with the reference window.
universe                = docker
docker_image            = $(md_image)
executable              = $(pipeline_dir)/condor/run.sh
arguments               = python3 analyze.py --run-dir .
transfer_input_files    = $(pipeline_dir)/analyze.py, $(pipeline_dir)/compare.py, $(pipeline_dir)/plots.py, $(pipeline_dir)/common.py, ref_window.pdb, ref_window.xtc, prep.json, fold, $(prod_dirs)
transfer_output_files   = analysis
initialdir              = $(run_dir)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
log                     = logs/analyze.log
output                  = logs/analyze.out
error                   = logs/analyze.err
request_cpus            = 2
request_memory          = 16GB
request_disk            = 10GB
queue
