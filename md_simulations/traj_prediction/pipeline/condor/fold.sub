# Step 2: ColabFold. Needs outbound internet for the MSA server.
universe                = docker
docker_image            = $(fold_image)
executable              = $(pipeline_dir)/fold.sh
arguments               = seqs.fasta $(fold_names)
transfer_input_files    = $(fold_inputs)
transfer_output_files   = fold
initialdir              = $(run_dir)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
log                     = logs/fold.log
output                  = logs/fold.out
error                   = logs/fold.err
request_cpus            = 4
request_memory          = 32GB
request_disk            = 30GB
request_gpus            = 1
+WantGPULab             = true
+GPUJobLength           = "short"
if ! defined gpu_requirements
  gpu_requirements      = (Machine == "bhaskargpu4000.chtc.wisc.edu" || TARGET.GPUs_DeviceName == "NVIDIA H200" || TARGET.GPUs_DeviceName == "NVIDIA H200 NVL" || TARGET.GPUs_DeviceName == "NVIDIA H100 80GB HBM3" || TARGET.GPUs_DeviceName == "NVIDIA A100-SXM4-80GB")
endif
Requirements            = (Target.HasCHTCStaging == true) && $(gpu_requirements)
queue
