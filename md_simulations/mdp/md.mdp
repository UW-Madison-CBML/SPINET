integrator               = md
nsteps                   = 500000     ; Adjust for your desired runtime
dt                       = 0.002      ; 2 femtosecond steps
; Trajectory & Energy Tracking
nstxout-compressed       = 500        ; Saves a compact .xtc trajectory file
nstpout                  = 500        ; Saves potential energy to .edr file
; Implicit Solvent Settings
implicit_solvent         = GBSA
gb_algorithm             = Still
rgbradii                 = 1.0
coulombtype              = Cut-off
vdwtype                  = Cut-off
pbc                      = none
