# Zero-shot evaluation of a RELEASED DynamicMPNN checkpoint -- no training. See
# eval_ckpt.py's docstring for the details; the short version:
#
#   * train.sub trains this architecture from scratch on our data. This job is the other
#     half of the comparison: upstream's published weights, our splits, our metrics.
#   * The released checkpoints are a DIFFERENT architecture than train.py's config (the
#     legacy pair model: 26/17 input scalars, 4+4 layers, representation=ca), so eval_ckpt.py
#     reads the model config out of the checkpoint itself rather than a yaml.
#   * They are also PAIR models. `single_chain_k5.ckpt` does not see 5 conformers here -- the
#     featuriser those weights were trained with consumes exactly 2, whatever its file name
#     says. Every checkpoint below therefore scores at an ensemble size of k=2, which is what
#     the run logs as `k`.
#
# Like train.sub this stays on the trajectory store (the ensemble input IS the thing being
# benchmarked), and the two datasets are scored SEPARATELY, one job each. ATLAS is the
# default; for mdCATH:
#
#   condor_submit eval_ckpt.sub DS_NAME=mdcath \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'
#
# To score one of the other released checkpoints:
#
#   condor_submit eval_ckpt.sub CKPT=DynamicMPNN/checkpoints/single_chain_k5.ckpt
#
# (Each knob is set under an `if ! defined` -- condor_submit applies command-line macros
# BEFORE parsing this file, so a bare assignment here would silently win over the override.)

docker_image = cmikulski4/dynamicmpnn:v8
universe = docker

ResearchDrive = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

DS_NAME = mdcath
DS_H5   = $(ResearchDrive)/mdcath_spinet_320_0.h5
DS_CSV  = $(ResearchDrive)/mdcath_320_0_topology_split.csv

if ! defined DS_NAME
  DS_NAME = atlas
endif
if ! defined DS_H5
  DS_H5   = $(ResearchDrive)/atlas_data.h5
endif
if ! defined DS_CSV
  DS_CSV  = $(ResearchDrive)/atlas_cross_val_index.csv
endif

# Ships inside DynamicMPNN.tar.gz, so it needs no transfer of its own -- eval_ckpt.sh untars
# it in the job's scratch. The k2 weights are the honest default: all three released
# checkpoints consume a conformer PAIR, and k2 is the one actually trained on pairs.
if ! defined CKPT
  CKPT = DynamicMPNN/checkpoints/single_chain_k2.ckpt
endif

shell = ./eval_ckpt.sh --ds-name $(DS_NAME) --ckpt $(CKPT) --splits val,test

log = logs/eval_ckpt_$(DS_NAME)_$(Cluster)_$(Process).log
error = logs/eval_ckpt_$(DS_NAME)_$(Cluster)_$(Process).err
output = logs/eval_ckpt_$(DS_NAME)_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
# The job needs a machine with internet access (W&B) -- the same one train.sub uses.
Requirements = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")

transfer_input_files = eval_ckpt.sh, eval_ckpt.py, train.py, DynamicMPNN.tar.gz, ../../lib/stats_utils.py, ../../lib/residue_classifier_dataset.py, ../../lib/dataset_splits.py, ../../../api_keys.txt, ../../scripts/load_dynamics.py, $(DS_H5), $(DS_CSV)

request_cpus = 8
# Only the two held-out splits are featurised, and there is no backward pass, so this is
# lighter than train.sub -- but the conformer-pool build still holds whole trajectories.
request_memory = 128GB
request_disk = 128GB
request_gpus = 1

+WantGPULab             = true
+GPUJobLength           = "short"

queue 1
