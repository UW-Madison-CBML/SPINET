# Fine-tune a RELEASED DynamicMPNN checkpoint on our training split -- the row between
# train.sub (from scratch) and eval_ckpt.sub (zero-shot). See finetune.py's docstring; the
# short version:
#
#   * The model is built from the checkpoint's own config (the legacy pair model), not
#     train.py's yaml, and -- as in eval_ckpt.sub -- every released checkpoint sees k=2.
#   * Val is scored once before the first update, so the first point of the val curve is the
#     zero-shot number on the same val set; test is scored once, with the best val epoch's
#     weights.
#   * The paper's regime: Adam at lr 1e-3, 32 proteins per optimizer step (2 per pass x 16
#     accumulated), early-stopped on val perplexity (patience 10); EPOCHS is only a cap.
#
# ATLAS is the default. For mdCATH, or another starting checkpoint / lr:
#
#   condor_submit finetune.sub DS_NAME=mdcath \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'
#   condor_submit finetune.sub CKPT=DynamicMPNN/checkpoints/single_chain_k5.ckpt LR=3e-5
#
# (Each knob is set under an `if ! defined` -- condor_submit applies command-line macros
# BEFORE parsing this file, so a bare assignment here would silently win over the override.)

docker_image = cmikulski4/dynamicmpnn:v8
universe = docker

ResearchDrive = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

DS_NAME = mdcath
DS_H5 = $(ResearchDrive)/mdcath_spinet_320_0.h5
DS_CSV = $(ResearchDrive)/mdcath_320_0_topology_split.csv

# DS_NAME = mdcath
# DS_H5 = $(ResearchDrive)/mdcath_spinet_450_0.h5
# DS_CSV = $(ResearchDrive)/mdcath_450_0_top_split.csv

if ! defined DS_NAME
  DS_NAME = atlas
endif
if ! defined DS_H5
  DS_H5   = $(ResearchDrive)/atlas_data.h5
endif
if ! defined DS_CSV
  DS_CSV  = $(ResearchDrive)/atlas_cross_val_index.csv
endif

# Ships inside DynamicMPNN.tar.gz, so it needs no transfer of its own -- finetune.sh untars
# it in the job's scratch. k2 is the default for the same reason as in eval_ckpt.sub: all
# three released checkpoints consume a conformer PAIR, and k2 is the one trained on pairs.
if ! defined CKPT
  CKPT = DynamicMPNN/checkpoints/single_chain_k2.ckpt
endif
if ! defined LR
  LR = 1e-3
endif
if ! defined EPOCHS
  EPOCHS = 200
endif

shell = ./finetune.sh --ds-name $(DS_NAME) --ckpt $(CKPT) --lr $(LR) --epochs $(EPOCHS) --train-pair-selection tm_min

# The staged trajectory store / split csv names, so lib/dataset_splits.py reads whichever
# mdCATH build (320, 450, ...) DS_H5 / DS_CSV point at instead of its fallback names.
environment = "DS_H5_FILE=$Fnx(DS_H5) DS_CSV_FILE=$Fnx(DS_CSV)"

log = logs/finetune_$(DS_NAME)_$(Cluster)_$(Process).log
error = logs/finetune_$(DS_NAME)_$(Cluster)_$(Process).err
output = logs/finetune_$(DS_NAME)_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
# finetune.py rewrites weights/<run_name>_<wandb id>.ckpt after every epoch, so this brings
# the latest weights home even if the job is evicted part-way through.
transfer_output_files = weights, logs
# The job needs a machine with internet access (W&B) -- the same one train.sub uses.
Requirements = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")

transfer_input_files = finetune.sh, finetune.py, eval_ckpt.py, train.py, DynamicMPNN.tar.gz, ../../lib/stats_utils.py, ../../lib/residue_classifier_dataset.py, ../../lib/dataset_splits.py, ../../../api_keys.txt, ../../scripts/load_dynamics.py, $(DS_H5), $(DS_CSV)

request_cpus = 8
request_memory = 128GB
request_disk = 128GB
request_gpus = 1

+WantGPULab             = true
+GPUJobLength           = "long"

queue 1
