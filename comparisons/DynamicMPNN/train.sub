docker_image = cmikulski4/dynamicmpnn:v8
universe = docker

# DynamicMPNN takes an ENSEMBLE of conformers sampled from the MD trajectory -- that
# ensemble input is the thing being benchmarked, so unlike comparisons/{MapDiff,PiFold}
# it is not retargeted onto relaxed structures.
#
# ATLAS and mdCATH are trained and evaluated SEPARATELY -- one job each, matching
# scripts/train_residue_classifier.py's --ds-name. ATLAS is the default; for mdCATH:
#
#   condor_submit train.sub DS_NAME=mdcath \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'

ResearchDrive = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

# DS_NAME = mdcath
# DS_H5   = $(ResearchDrive)/mdcath_spinet_320_0_v2.h5
# DS_CSV  = $(ResearchDrive)/mdcath_320_0_topo_split.csv

#DS_NAME = atlas
#DS_H5   = $(ResearchDrive)/atlas_data.h5
#DS_CSV  = $(ResearchDrive)/atlas_cross_val_index.csv

DS_NAME = mdcath
DS_H5   = $(ResearchDrive)/mdcath_spinet_450_0_v2.h5
DS_CSV  = $(ResearchDrive)/mdcath_450_0_topo_split.csv


# k = 20: the ATLAS k sweep (sweep_k.sub) kept improving val perplexity with k (9.73 at k=2,
# 8.16 at k=10, 7.99 at k=20), and k=20 at 1 protein per forward pass is the largest load
# measured to fit on the H200 (k=20 x 2 proteins ran out of memory). 1 protein per pass x 32
# accumulated gives the paper's 32 proteins per optimizer step (--effective-batch-size).
#
# Pool 64 per protein, drawn from every replica's whole trajectory: well above k, so each
# epoch's draw of k is a genuinely different subset (check_pool_sizes fails the job if a pool
# is short). $(FRAME_SELECTION) picks the pool -- 'fps' (most structurally distinct frames by
# TM-score, the default) or 'uniform' (random frames, no TM-score: the control for fps):
#   condor_submit train.sub FRAME_SELECTION=uniform
# 200 epochs is upstream's max_epochs, only a cap: early stopping on val perplexity
# (patience 10) ends the run first.
if ! defined FRAME_SELECTION
  FRAME_SELECTION = fps
endif
shell = ./train.sh --from-scratch --ds-name $(DS_NAME) --k 20 --pool-size 64 --frame-selection $(FRAME_SELECTION) --batch-size 1 --epochs 200

# The staged trajectory store / split csv names, so lib/dataset_splits.py reads whichever
# mdCATH build (320, 450, ...) DS_H5 / DS_CSV point at instead of its fallback names.
environment = "DS_H5_FILE=$Fnx(DS_H5) DS_CSV_FILE=$Fnx(DS_CSV)"

log = logs/train_$(DS_NAME)_$(Cluster)_$(Process).log
error = logs/train_$(DS_NAME)_$(Cluster)_$(Process).err
output = logs/train_$(DS_NAME)_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
# train.py rewrites weights/<run_name>_<wandb id>.ckpt after every epoch, so this brings the
# latest weights home even if the job is evicted part-way through training.
transfer_output_files = weights, logs
transfer_output_remaps = "weights = weights_$(DS_NAME)_$(Cluster)_$(Process)"
# The job needs a machine with internet access (W&B) -- same one
# scripts/train_residue_classifier.sub uses.
#Requirements = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")
Requirements            = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu" || TARGET.GPUs_DeviceName == "NVIDIA H100 80GB HBM3" || TARGET.GPUs_DeviceName == "NVIDIA A100-SXM4-80GB" || TARGET.GPUs_DeviceName == "NVIDIA H200" || TARGET.GPUs_DeviceName == "NVIDIA H200 NVL")

transfer_input_files = train.sh, train.py, DynamicMPNN.tar.gz, ../../lib/stats_utils.py, ../../lib/residue_classifier_dataset.py, ../../lib/dataset_splits.py, ../../../api_keys.txt, ../../scripts/load_dynamics.py, $(DS_H5), $(DS_CSV)

request_cpus = 8
request_memory = 128GB
request_disk = 200GB
request_gpus = 1

+WantGPULab             = true
+GPUJobLength           = "long"

queue 1
