docker_image = cmikulski4/dynamicmpnn:v5
universe = docker


shell = ./train.sh 

log = logs/train_$(Cluster)_$(Process).log
error = logs/train_$(Cluster)_$(Process).err
output = logs/train_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
# ESMFold (scRMSD) downloads facebook/esmfold_v1 from Hugging Face at run time, so this
# needs a machine with internet access -- same one scripts/train_residue_classifier.sub uses.
Requirements = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")



transfer_input_files = train.sh, train.py, DynamicMPNN.tar.gz, ../../lib/scrmsd.py, ../../lib/stats_utils.py, ../../lib/residue_classifier_dataset.py, ../../api_keys.txt, pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics/atlas_data.h5, pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics/atlas_cross_val_index.csv, ../../scripts/load_dynamics.py


request_cpus = 8
request_memory = 64GB
request_disk = 256GB
request_gpus = 1

queue 1
