# CHTC HTCondor submit file: zero-shot evaluation of the PRE-TRAINED ADFLIP weights (ICML 2025,
# `results/weights/ADFLIP_v1.pt` from the upstream release) on our held-out split -- no training.
# See eval_pretrained.py's docstring. There is no train.sub counterpart: ADFLIP's released
# checkpoint is trained on ~149K PDB entries, so retraining it on our data is a different
# experiment, and the training-overlap caveat is reported per run instead (N_STATES aside, look
# for `adflip_training_overlap` in the summary).
#
# N_STATES is the axis the reviewer asked about, and the two rows of the paper's Table 3:
#
#   condor_submit eval_pretrained.sub N_STATES=1    # "ADFLIP single"   (= upstream adaptive_sample)
#   condor_submit eval_pretrained.sub N_STATES=8    # "ADFLIP multiple" (= Algorithm 1)
#
# Defaults to the mdCATH 320 K store with the cleaned topology split; for ATLAS:
#
#   condor_submit eval_pretrained.sub DS_NAME=ATLAS \
#       DS_H5='$(ResearchDrive)/atlas_data.h5' \
#       DS_CSV='$(ResearchDrive)/atlas_cross_val_index.csv'
#
# Other knobs: SPLIT=valid, STRUCTURE_SOURCE=relaxed (forces one state), LIMIT=2 for a smoke
# test, ADFLIP_TARBALL='$(ResearchDrive)/...'.
# (Each is set under `if ! defined` -- condor_submit applies command-line macros BEFORE parsing
# this file, so a bare assignment here would silently win over the override.)
#
# Submit (transfer_output_remaps below writes into ../results, which HTCondor will not create
# for you -- same destination ../PiFold/eval_pretrained.sub uses):
#   mkdir -p logs ../results && condor_submit eval_pretrained.sub

universe                = docker
docker_image            = cmikulski4/adflip:v1

ResearchDrive           = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

if ! defined DS_NAME
  DS_NAME               = MDCATH
endif
if ! defined DS_H5
  DS_H5                 = $(ResearchDrive)/mdcath_spinet_320_0_v2.h5
endif
if ! defined DS_CSV
  DS_CSV                = $(ResearchDrive)/mdcath_clean_topo_split.csv
endif
# The checkout, its released checkpoint and PIPPack's side-chain weights, tarred together --
# eval_pretrained.sh extracts it to ./ADFLIP and refuses to start if the PIPPack weights are
# missing from it. Build with:
#   tar -czf ADFLIP.tar.gz -C comparisons/ADFLIP ADFLIP
if ! defined ADFLIP_TARBALL
  ADFLIP_TARBALL        = ./ADFLIP.tar.gz
endif
if ! defined SPLIT
  SPLIT                 = test
endif
if ! defined STRUCTURE_SOURCE
  STRUCTURE_SOURCE      = frame
endif
if ! defined N_STATES
  N_STATES              = 1
endif
if ! defined LIMIT
  LIMIT                 = 0
endif

executable              = eval_pretrained.sh
# The staged trajectory store / split csv names, so lib/dataset_splits.py reads whichever
# mdCATH build / split DS_H5 / DS_CSV point at instead of its fallback names.
environment             = "DS_H5_FILE=$Fnx(DS_H5) DS_CSV_FILE=$Fnx(DS_CSV)"
# HTCondor drops the staged files flat into the scratch dir, which is where eval_pretrained.sh
# runs; eval_pretrained.py resolves these paths before it chdirs into the checkout.
arguments               = --data-name $(DS_NAME) --traj-h5 ./$Fnx(DS_H5) --index-csv ./$Fnx(DS_CSV) --split $(SPLIT) --structure-source $(STRUCTURE_SOURCE) --n-states $(N_STATES) --limit $(LIMIT) --res-dir ./results --wandb-key-file ./wandb_api.txt

transfer_input_files    = eval_pretrained.sh, eval_pretrained.py, multi_state.py, $(ADFLIP_TARBALL), ../../../api_keys.txt, ../../lib/relaxed_pdb.py, ../../lib/traj_frames.py, ../../lib/dataset_splits.py, ../../lib/stats_utils.py, $(DS_H5), $(DS_CSV)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = results
transfer_output_remaps  = "results = ../results/pretrained_$(DS_NAME)_$(SPLIT)_$(STRUCTURE_SOURCE)_$(N_STATES)states_$(Cluster)_$(Process)"

log                     = logs/eval_pretrained_$(DS_NAME)_$(N_STATES)states_$(Cluster)_$(Process).log
output                  = logs/eval_pretrained_$(DS_NAME)_$(N_STATES)states_$(Cluster)_$(Process).out
error                   = logs/eval_pretrained_$(DS_NAME)_$(N_STATES)states_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 64GB
request_disk            = 128GB

# Sampling is far slower than the other comparisons' eval jobs: the adaptive sampler runs the
# denoiser once per conformation per flow step and repacks side chains with PIPPack after every
# step, so one protein costs up to N_STATES x --num-step packing passes (writing and re-parsing a
# PDB each time). At N_STATES=8 that is ~64 per protein, hence the long job length rather than
# ../PiFold's "short". Drop to "short" for a LIMIT=2 smoke test.
+WantGPULab             = true
+GPUJobLength           = "long"

# W&B needs internet, and --structure-source relaxed additionally downloads deposited structures
# from RCSB -- same machine the other comparisons use.
Requirements            = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu" || TARGET.GPUs_DeviceName == "NVIDIA H200" || TARGET.GPUs_DeviceName == "NVIDIA H200 NVL")

queue 1
