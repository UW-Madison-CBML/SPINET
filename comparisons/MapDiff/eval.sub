# CHTC HTCondor submit file for evaluating a trained MapDiff checkpoint on a
# dataset's held-out test split (Docker universe, GPU), logging results (including
# self-consistency RMSD against the relaxed/deposited structure) to W&B.
#
# Setup (one-time): same image as training -- see train.sub / README.md.
#
# Prerequisite: a trained diffusion checkpoint from train.sub
# (./results/<ds>_mapdiff_<Cluster>_<Process>/outputs/.../model/*.pt) and
# that same run's resolved config (.../outputs/.../configs/config.yaml).
# HTCondor's file transfer drops files in flat (no subdirectories), so
# fill in the actual paths below after your training job finishes.
#
# ATLAS and mdCATH are evaluated SEPARATELY. ATLAS is the default; for mdCATH:
#
#   condor_submit eval.sub DS_NAME=mdcath \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'
#
# Submit:
#   mkdir -p logs && condor_submit eval.sub

universe                = docker
docker_image            = cmikulski4/dynamicmpnn:v8

ResearchDrive           = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

# Override these three together to switch datasets (see the header).
DS_NAME                 = atlas
DS_H5                   = $(ResearchDrive)/atlas_data.h5
DS_CSV                  = $(ResearchDrive)/atlas_cross_val_index.csv

executable              = eval.sh
# Forwarded verbatim to `python eval_relaxed.py ...`. --checkpoint/--config point at
# the files transferred in flat below (HTCondor flattens transferred paths, so
# $(CHECKPOINT) lands in the job's scratch root). eval_relaxed.py defaults --index-csv
# and --traj-h5 to the dataset's standard file names, which is where they land.
arguments               = --checkpoint ./$(CHECKPOINT) --config ./config.yaml --ds-name $(DS_NAME) --wandb_key_file ./wandb_api.txt

# Which trained run to evaluate. RUN_DIR is one of train.sub's output
# directories (transfer_output_remaps drops them under ./results/) and
# CHECKPOINT is the .pt inside its model/ subdir -- override both on the
# command line rather than editing this file:
#
#   condor_submit eval.sub \
#       RUN_DIR=./results/atlas_mapdiff_6200001_0/atlas_mapdiff_2026-09-12_10-00-00 \
#       CHECKPOINT=atlas_mapdiff_best_8_epochs_10641_steps_2026-09-12_12-30-00.pt
RUN_DIR                 = ./results/diffusion_6144182_0/atlas_diffusion_2026-09-01_20-11-39
CHECKPOINT              = atlas_mapdiff_best.pt

# The pristine MapDiff tarball, this folder's dataset/wandb/scRMSD additions, the
# eval script, the trained checkpoint + its resolved Hydra config, the API-key file
# (eval.sh splits the W&B key out of it into wandb_api.txt),
# lib/{scrmsd,stats_utils,relaxed_pdb,traj_frames,dataset_splits}.py, and the dataset's
# trajectory store (reference residue sequences) + split index.
transfer_input_files    = eval.sh, eval_relaxed.py, conf, dataloader, model, data, ../../../api_keys.txt, ../../lib/scrmsd.py, ../../lib/stats_utils.py, ../../lib/relaxed_pdb.py, ../../lib/traj_frames.py, ../../lib/dataset_splits.py, MapDiff.tar.gz, $(RUN_DIR)/model/$(CHECKPOINT), $(RUN_DIR)/configs/config.yaml, $(DS_H5), $(DS_CSV)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

log                     = logs/eval_$(DS_NAME)_$(Cluster)_$(Process).log
output                  = logs/eval_$(DS_NAME)_$(Cluster)_$(Process).out
error                   = logs/eval_$(DS_NAME)_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 16GB
request_disk            = 30GB

# ESMFold + RCSB downloads need internet access -- pin to the same machine
# scripts/train_residue_classifier.sub uses for that reason.
Requirements            = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")
+WantGPULab             = true
+GPUJobLength           = "short"

queue 1
