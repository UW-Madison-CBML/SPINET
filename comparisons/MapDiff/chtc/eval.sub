# CHTC HTCondor submit file for evaluating a trained MapDiff checkpoint on
# the ATLAS test split (Docker universe, GPU), logging results to W&B.
#
# Setup (one-time): same image as training -- see mask_pretrain.sub /
# train.sub / README.md.
#
# Prerequisite: a trained diffusion checkpoint from train.sub
# (../results/diffusion_<Cluster>_<Process>/outputs/.../model/*.pt) and that
# same run's resolved config (.../outputs/.../configs/config.yaml).
# HTCondor's file transfer drops files in flat (no subdirectories), so
# fill in the actual paths below (see FIXME) after your training job
# finishes -- rename the local copies to checkpoint.pt / config.yaml, or
# use your condor version's `transfer_input_files = src=dest` remap syntax
# if it supports it, so they land under those flat names.
#
# Submit:
#   cd chtc && mkdir -p logs && condor_submit eval.sub

universe                = docker
docker_image            = cmikulski4/mapdiff:v1

executable              = run_eval.sh
# Forwarded verbatim to `python eval_atlas.py ...` -- see ../eval_atlas.py.
# --checkpoint/--config point at the files transferred in flat below.
arguments               = --checkpoint ./checkpoint.pt --config ./config.yaml --data_root ./surffold_data/ --wandb_key_file ./wandb_api.txt

# The pristine MapDiff tarball, this folder's ATLAS overlay, the eval
# script, the trained checkpoint + its resolved Hydra config (FIXME: fill
# in the real paths from your train.sub run), the W&B key,
# lib/stats_utils.py, and the ATLAS-derived dataset staged on /staging.
transfer_input_files    = ../MapDiff.tar.gz, ../overlay, ../eval_atlas.py, ../results/diffusion_6144182_0/atlas_diffusion_2026-09-01_20-11-39/model/atlas_diffusion_last_8_epochs_10641_steps_2026-09-01_22-36-08.pt, ../results/diffusion_6144182_0/atlas_diffusion_2026-09-01_20-11-39/configs/config.yaml, ../wandb_api.txt, ../../lib/stats_utils.py, file:///staging/groups/bhaskar_group/sheaf_protein_dynamics/surffold_data.tar.gz

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

log                     = logs/eval_$(Cluster)_$(Process).log
output                  = logs/eval_$(Cluster)_$(Process).out
error                   = logs/eval_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 16GB
request_disk            = 20GB

# Only match GPU nodes with a modern-enough driver/CUDA for the cu117 image.
requirements            = (Target.CUDADriverVersion >= 11.7)
+WantGPULab             = true
+GPUJobLength           = "short"

queue 1
