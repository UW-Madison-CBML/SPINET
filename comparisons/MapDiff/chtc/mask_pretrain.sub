# CHTC HTCondor submit file for MapDiff stage 1: mask-prior IPA
# pretraining on ATLAS (Docker universe, GPU).
#
# MapDiff.tar.gz should be a tarball of a *pristine* checkout of
# peizhenbai/MapDiff (`git clone https://github.com/peizhenbai/MapDiff &&
# tar czf MapDiff.tar.gz MapDiff/`) -- run_mask_pretrain.sh overlays
# ../overlay/ (ATLAS dataset support + wandb wiring) on top of it at run
# time, so the repo itself is never modified. See ../README.md.
#
# Setup (one-time):
#   1. ./build_and_push.sh <dockerhub_username>   # builds+pushes the image
#   2. Set docker_image below to that image.
#
# Dataset: raw ATLAS structures (initial static structure of each MD sim,
# pre-split into train/validation/test) are staged at
# /staging/groups/bhaskar_group/sheaf_protein_dynamics/surffold_data.tar.gz
# and transferred in via transfer_input_files below. run_mask_pretrain.sh
# extracts the tarball and featurizes the train split into MapDiff graphs
# (data/generate_graph_atlas.py) before training starts.
#
# comet.use=False below because CHTC jobs have no interactive comet.ml
# login; wandb.use=True logs the same run to Weights & Biases instead
# (key-file auth works fine non-interactively -- see ../wandb_api.txt).
#
# Submit:
#   cd chtc && mkdir -p logs && condor_submit mask_pretrain.sub

universe                = docker
docker_image            = cmikulski4/mapdiff:v1

executable              = run_mask_pretrain.sh
# Forwarded verbatim to `python mask_ipa_pretrain.py ...` -- see
# ../overlay/conf/mask_pretrain.yaml. dataset.train_dir overrides
# conf/dataset/atlas.yaml's default to match where run_mask_pretrain.sh
# actually featurizes the staged tarball in the job's scratch dir.
arguments               = --config-name=mask_pretrain dataset=atlas dataset.train_dir=./surffold_data/atlas_process/train/ comet.use=False wandb.use=True wandb.key_file=./wandb_api.txt experiment.name=atlas_mask_ipa

# The pristine MapDiff tarball, this folder's ATLAS/wandb overlay, the W&B
# key, lib/stats_utils.py (shared across all three models -- see ../../lib),
# and the ATLAS-derived dataset staged on /staging.
transfer_input_files    = ../MapDiff.tar.gz, ../overlay, ../wandb_api.txt, ../../lib/stats_utils.py, file:///staging/groups/bhaskar_group/sheaf_protein_dynamics/surffold_data.tar.gz

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = MapDiff/outputs
transfer_output_remaps  = "MapDiff/outputs = ../results/mask_pretrain_$(Cluster)_$(Process)"

log                     = logs/mask_pretrain_$(Cluster)_$(Process).log
output                  = logs/mask_pretrain_$(Cluster)_$(Process).out
error                   = logs/mask_pretrain_$(Cluster)_$(Process).err

request_gpus            = 2
request_cpus            = 4
request_memory          = 32GB
request_disk            = 30GB

# Only match GPU nodes with a modern-enough driver/CUDA for the cu117 image.
requirements            = (Target.CUDADriverVersion >= 11.7)
+WantGPULab             = true
+GPUJobLength           = "medium"

queue 1
