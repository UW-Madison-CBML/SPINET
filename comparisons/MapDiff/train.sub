# CHTC HTCondor submit file for training MapDiff end-to-end: mask-prior IPA
# pretraining + denoising diffusion training, in one job (Docker universe, GPU).
# See train.py / trainer.py.
#
# MapDiff.tar.gz should be a tarball of a *pristine* checkout of
# peizhenbai/MapDiff (`git clone https://github.com/peizhenbai/MapDiff &&
# tar czf MapDiff.tar.gz MapDiff/`) -- train.sh overlays this folder's
# dataset/wandb additions on top of it at run time, so the repo itself
# is never modified. See README.md.
#
# Setup (one-time):
#   1. ./build_and_push.sh <dockerhub_username>   # builds+pushes the image
#   2. Set docker_image below to that image.
#
# Dataset: MapDiff is a static-structure model, so it trains and evaluates on each
# protein's *relaxed* structure: for ATLAS the deposited PDB entry, downloaded from RCSB by
# lib/relaxed_pdb.py and cropped to the residues its MD trajectory covers; for mdCATH the
# CATH domain file itself (CATH_PDBS below), used whole with no cropping. train.sh runs
# data/generate_graph_relaxed.py to featurize those structures into MapDiff graphs
# before training starts. The trajectory store is transferred in only to supply those
# reference residue sequences; the split index csv gives the partition.
#
# ATLAS and mdCATH are trained and evaluated SEPARATELY -- one job each, matching
# scripts/train_residue_classifier.py's --ds-name. ATLAS is the default; for mdCATH:
#
#   condor_submit train.sub DS_NAME=mdcath \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'
#
# wandb.use=True below logs both stages to a single Weights & Biases run
# (key-file auth works fine non-interactively -- see wandb_api.txt, not
# checked in). The RCSB download needs internet access -- pinned to a machine
# that has it.
#
# Submit:
#   mkdir -p logs && condor_submit train.sub

universe                = docker
docker_image            = cmikulski4/mapdiff:v5

ResearchDrive           = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

# DS_NAME                 = mdcath
# DS_H5                   = $(ResearchDrive)/mdcath_spinet_320_0.h5
# DS_CSV                  = $(ResearchDrive)/mdcath_320_0_topology_split.csv

DS_NAME                 = atlas
DS_H5                   = $(ResearchDrive)/atlas_data.h5
DS_CSV                  = $(ResearchDrive)/atlas_cross_val_index.csv

#DS_NAME                 = mdcath
# DS_H5                   = $(ResearchDrive)/mdcath_spinet_450_0.h5
# DS_CSV                  = $(ResearchDrive)/mdcath_450_0_top_split.csv



# What MapDiff trains on: 'relaxed' (each protein's deposited RCSB entry, the default) or
# 'frame' (one random frame of its MD trajectory, lib/traj_frames.py). train.sh derives both
# the featurization flag and dataset.process_root from this, so they cannot disagree.
# Override at submit time:  condor_submit train.sub STRUCTURE_SOURCE=frame
#STRUCTURE_SOURCE        = frame
STRUCTURE_SOURCE 	 = frame

# CATH domain structures for mdCATH's relaxed source (train.sh extracts them into pdbs/).
CATH_PDBS               = $(ResearchDrive)/mdcath_pdbs.tar.gz

executable              = train.sh
# The staged trajectory store / split csv names, so lib/dataset_splits.py reads whichever
# mdCATH build (320, 450, ...) DS_H5 / DS_CSV point at instead of its fallback names.
environment             = "DS_NAME=$(DS_NAME) STRUCTURE_SOURCE=$(STRUCTURE_SOURCE) DS_H5_FILE=$Fnx(DS_H5) DS_CSV_FILE=$Fnx(DS_CSV)"
# Forwarded verbatim to `python train.py ...` -- see conf/train.yaml. train.sh prepends the
# dataset.process_root / dataset.marginal_train_dir that match $(STRUCTURE_SOURCE), so only
# the run/wandb wiring needs setting here. Pass prior_model.path=<ckpt> to skip stage 1 and
# load an already-trained mask-prior IPA checkpoint instead.
arguments               = dataset=$(DS_NAME) wandb.use=True wandb.key_file=./wandb_api.txt experiment.name=$(DS_NAME)_$(STRUCTURE_SOURCE)_mapdiff

# The pristine MapDiff tarball, this folder's dataset/wandb additions, the
# API-key file (train.sh splits the W&B key out of it into wandb_api.txt),
# lib/{stats_utils,relaxed_pdb,traj_frames,dataset_splits}.py (shared across all models --
# see ../../lib), and the dataset's trajectory store + split index.
transfer_input_files    = train.sh, train.py, trainer.py, conf, dataloader, model, data, ../../../api_keys.txt, ../../lib/stats_utils.py, ../../lib/relaxed_pdb.py, ../../lib/traj_frames.py, ../../lib/dataset_splits.py, MapDiff.tar.gz, $(DS_H5), $(DS_CSV), $(CATH_PDBS)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = MapDiff/outputs
transfer_output_remaps  = "MapDiff/outputs = ./results/$(DS_NAME)_$(STRUCTURE_SOURCE)_mapdiff_$(Cluster)_$(Process)"

log                     = logs/train_$(DS_NAME)_$(Cluster)_$(Process).log
output                  = logs/train_$(DS_NAME)_$(Cluster)_$(Process).out
error                   = logs/train_$(DS_NAME)_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 16
request_memory          = 128GB
request_disk            = 200GB


# The RCSB download needs internet access -- pin to the same machine
# scripts/train_residue_classifier.sub uses for that reason. Also only
# match GPU nodes with a modern-enough driver/CUDA for the cu124 image.
Requirements            = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")
+WantGPULab             = true
+GPUJobLength           = "long"

queue 1
