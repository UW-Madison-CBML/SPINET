# CHTC HTCondor submit file for PiFold training/inference (Docker universe, GPU).
#
# PiFold.tar.gz should be a tarball of a *pristine* checkout of A4Bio/PiFold
# (`git clone https://github.com/A4Bio/PiFold && tar czf PiFold.tar.gz PiFold/`)
# -- run_pifold.sh overlays ../overlay/ (ATLAS dataset support + wandb wiring)
# on top of it at run time, so the repo itself is never modified. See
# ../README.md.
#
# Setup (one-time):
#   1. ../chtc/build_and_push.sh <dockerhub_username>   # builds+pushes the image
#   2. Set docker_image below to that image.
#
# Dataset: ATLAS-derived data (first MD frame per simulation, pre-split into
# train/valid/test) is staged at
# /staging/groups/bhaskar_group/sheaf_protein_dynamics/surffold_data.tar.gz
# and transferred in via transfer_input_files below. run_pifold.sh extracts
# it into PiFold/surffold_data/ before main.py runs.
#
# Submit:
#   cd chtc && mkdir -p logs && condor_submit pifold.sub

universe                = docker
docker_image            = cmikulski4/pifold:v2

executable              = run_pifold.sh
# Forwarded verbatim to `python main.py ...` -- see ../overlay/parser.py for
# all options (dataset args, model hyperparameters, --wandb_*).
arguments               = --data_name ATLAS --data_root ./surffold_data/ --batch_size 8 --epoch 100 --res_dir ./results --ex_name chtc_run --wandb_key_file ./wandb_api.txt

# The pristine PiFold tarball, this folder's ATLAS/wandb overlay, the W&B key,
# lib/stats_utils.py (shared across all three models -- see ../../lib), and
# the ATLAS-derived dataset staged on /staging.
transfer_input_files    = ../PiFold.tar.gz, ../overlay, ../wandb_api.txt, ../../lib/stats_utils.py, file:///staging/groups/bhaskar_group/sheaf_protein_dynamics/surffold_data.tar.gz

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = PiFold/results
transfer_output_remaps  = "PiFold/results = ../results/$(Cluster)_$(Process)"

log                     = logs/pifold_$(Cluster)_$(Process).log
output                  = logs/pifold_$(Cluster)_$(Process).out
error                   = logs/pifold_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 32GB
request_disk            = 20GB

# Only match GPU nodes with a modern-enough driver/CUDA for the cu118 image.
requirements            = (Target.CUDADriverVersion >= 11.8)
+WantGPULab             = true
+GPUJobLength           = "medium"

queue 1
