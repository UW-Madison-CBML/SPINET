# CHTC HTCondor submit file for PiFold training/inference (Docker universe, GPU).
#
# Setup (one-time):
#   1. ./build_and_push.sh <dockerhub_username>   # builds+pushes the image
#   2. Set docker_image below to that image.
#
# Dataset: the shared ATLAS hdf5 store (atlas_data.h5) + cross-validation index
# (atlas_cross_val_index.csv) -- the same store/split scripts/train_residue_classifier.py
# and comparisons/{gvp-pytorch,DynamicMPNN}/train.py use -- transferred in flat via
# transfer_input_files below. atlas_dataset.py (baked into PiFold.tar.gz's API/) reads
# them directly: fold 0 of `cross_val` is held out as validation, and reused as the test
# split too (ATLAS only has one held-out fold).
#
# Submit:
#   cd condor_submit pifold.sub

universe                = docker
docker_image            = cmikulski4/pifold:v1

executable              = run_pifold.sh
arguments               = --data_name ATLAS --data_root ./ --batch_size 8 --epoch 100 --res_dir ./results --ex_name chtc_run

transfer_input_files    = PiFold.tar.gz, pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics/atlas_data.h5, pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics/atlas_cross_val_index.csv

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = results
transfer_output_remaps  = "results = ../results/$(Cluster)_$(Process)"

log                     = logs/pifold_$(Cluster)_$(Process).log
output                  = logs/pifold_$(Cluster)_$(Process).out
error                   = logs/pifold_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 32GB
request_disk            = 20GB

# Only match GPU nodes with a modern-enough driver/CUDA for the cu118 image.
requirements            = (Target.CUDADriverVersion >= 11.8)
+WantGPULab             = true
+GPUJobLength           = "medium"

queue 1
