# CHTC HTCondor submit file for PiFold training/inference (Docker universe, GPU).
#
# Setup (one-time):
#   1. ./build_and_push.sh <dockerhub_username>   # builds+pushes the image
#   2. Set docker_image below to that image.
#   3. git clone https://github.com/A4Bio/PiFold && tar czf PiFold.tar.gz PiFold/
#      (a *pristine* checkout -- train.sh overlays this folder's API/, main.py
#      and parser.py on top of it at run time, so upstream is never modified.)
#
# Dataset: PiFold is a static-structure model, so it trains and evaluates on each
# protein's *relaxed* (deposited) PDB entry, downloaded from RCSB by lib/relaxed_pdb.py
# and cropped to the residues its MD trajectory covers (API/relaxed_dataset.py). The
# trajectory store is transferred in only to supply those reference residue sequences;
# the split index csv gives the partition.
#
# ATLAS and mdCATH are trained and evaluated SEPARATELY -- one job each, matching
# scripts/train_residue_classifier.py's --ds-name. ATLAS is the default; for mdCATH:
#
#   condor_submit pifold.sub DS_NAME=MDCATH \
#       DS_H5='$(ResearchDrive)/mdcath_spinet_320_0.h5' \
#       DS_CSV='$(ResearchDrive)/mdcath_320_0_topology_split.csv'
#
# Submit:
#   mkdir -p logs && condor_submit pifold.sub

universe                = docker
docker_image            = cmikulski4/pifold:v5

ResearchDrive           = pelican://chtc.wisc.edu/researchdrive/dbhaskar3/CHTC/sheaf_protein_dynamics

DS_NAME                 = ATLAS
DS_H5                   = $(ResearchDrive)/atlas_data.h5
DS_CSV                  = $(ResearchDrive)/atlas_cross_val_index.csv

# DS_NAME                 = MDCATH
# DS_H5                   = $(ResearchDrive)/mdcath_spinet_320_0.h5
# DS_CSV                  = $(ResearchDrive)/mdcath_320_0_topology_split.csv

executable              = train.sh
# --data_root ./ points API/relaxed_dataset.py at the job's scratch dir, where HTCondor
# drops the split index and trajectory store flat. Everything here is forwarded straight
# to main.py (see parser.py).
#
# $(STRUCTURE_SOURCE) picks what PiFold trains on: 'relaxed' (each protein's deposited RCSB
# entry, the default) or 'frame' (one random frame of its MD trajectory, lib/traj_frames.py).
# Override at submit time:  condor_submit train.sub STRUCTURE_SOURCE=frame
STRUCTURE_SOURCE        = relaxed
arguments               = --data_name $(DS_NAME) --data_root ./ --structure_source $(STRUCTURE_SOURCE) --batch_size 8 --epoch 100 --res_dir ./results --ex_name chtc_run --wandb_key_file ./wandb_api.txt

# The pristine PiFold tarball, this folder's overlay, the API-key file (train.sh
# splits the W&B key out of it into wandb_api.txt), lib/{relaxed_pdb,traj_frames,dataset_splits,
# stats_utils}.py (shared across all models -- see ../../lib), and the dataset's trajectory
# store + split index.
transfer_input_files    = PiFold.tar.gz, API, main.py, parser.py, ../../../api_keys.txt, ../../lib/relaxed_pdb.py, ../../lib/traj_frames.py, ../../lib/dataset_splits.py, ../../lib/stats_utils.py, $(DS_H5), $(DS_CSV)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = PiFold/results
transfer_output_remaps  = "PiFold/results = ../results/$(DS_NAME)_$(STRUCTURE_SOURCE)_$(Cluster)_$(Process)"

log                     = logs/pifold_$(DS_NAME)_$(Cluster)_$(Process).log
output                  = logs/pifold_$(DS_NAME)_$(Cluster)_$(Process).out
error                   = logs/pifold_$(DS_NAME)_$(Cluster)_$(Process).err

request_gpus            = 1
request_cpus            = 8
request_memory          = 128GB
request_disk            = 200GB

# lib/relaxed_pdb.py downloads from files.rcsb.org, so this needs a machine with internet
# access -- the same one scripts/train_residue_classifier.sub uses. Also only match GPU
# nodes with a modern-enough driver/CUDA for the cu118 image.
Requirements            = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")
+WantGPULab             = true
+GPUJobLength           = "medium"

queue 1
