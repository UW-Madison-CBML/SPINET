universe = container

container_image = docker://jennyan527/alphafold3:2026-09

executable = run_af3_pullback.sh
arguments = native__state_00__target.json

log    = af3_pullback_$(Cluster)_$(Process).log
output = af3_pullback_$(Cluster)_$(Process).out
error  = af3_pullback_$(Cluster)_$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = \
    run_af3_pullback.sh, \
    prepared/native_state_00/native__state_00__target.json, \
    prepared/native_state_00/state_00_target.cif, \
    ../../af3_models/af3.bin.zst

transfer_output_files = af3_output

+WantGPULab = true

request_cpus = 4
request_memory = 32GB
request_disk = 32GB
request_gpus = 1

requirements = \
    (Target.HasCHTCStaging == true) && \
    (Machine == "bhaskargpu4000.chtc.wisc.edu")

queue