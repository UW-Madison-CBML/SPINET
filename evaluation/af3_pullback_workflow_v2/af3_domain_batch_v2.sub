universe = container
container_image = docker://jennyan527/alphafold3:2026-09

executable = run_af3_domain_batch.sh
arguments = $(package_id) $(package_tar)

log = logs/$(package_id).log
output = logs/$(package_id).out
error = logs/$(package_id).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

MODEL_WEIGHTS = af3.bin.zst
transfer_input_files = $(package_tar),$(MODEL_WEIGHTS)
transfer_output_files = af3_results_$(package_id).tar.gz
transfer_output_remaps = "af3_results_$(package_id).tar.gz=results/af3_results_$(package_id).tar.gz"

request_cpus = 4
request_memory = 32GB
request_disk = 40GB
request_gpus = 1

+WantGPULab = true
requirements = (Target.HasCHTCStaging == true) && (Machine == "bhaskargpu4000.chtc.wisc.edu")

queue package_id,package_tar from $(queue_file)
